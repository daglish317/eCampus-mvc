@using eCampus.web.Common
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — eCampus</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen flex-col bg-slate-50 text-slate-900">

    @* Lien d'évitement : permet aux lecteurs d'écran et au clavier de sauter le menu *@
    <a href="#contenu"
       class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-slate-900 focus:shadow-lg">
        Aller au contenu principal
    </a>

    <header class="bg-slate-900 text-white">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-3">

            @* Identité de l'application *@
            <a asp-area="" asp-controller="Home" asp-action="Index"
               class="text-lg font-semibold tracking-tight">
                eCampus
            </a>

            @* Bouton d'ouverture du menu sur petit écran *@
            <button type="button" id="btn-menu" aria-expanded="false" aria-controls="menu-principal"
                    class="rounded-md p-2 hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-white md:hidden">
                <span class="sr-only">Ouvrir le menu</span>
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>

            @* Zone de connexion *@
            <div class="order-2 md:order-3">
                <partial name="_LoginPartial" />
            </div>

            @* Navigation principale *@
            <nav id="menu-principal" aria-label="Navigation principale"
                 class="order-3 hidden w-full md:order-2 md:block md:w-auto">
                <ul class="flex flex-col gap-1 md:flex-row md:items-center md:gap-2">
                    <li>
                        <a asp-area="" asp-controller="Home" asp-action="Index"
                           class="block rounded-md px-3 py-2 hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-white">
                            Accueil
                        </a>
                    </li>

                    @* Les liens des modules seront ajoutés ici quand leurs Controllers existeront *@
                </ul>
            </nav>
        </div>
    </header>

    @* Contenu principal de la page *@
    <main id="contenu" class="mx-auto w-full max-w-7xl flex-1 px-4 py-6">
        @RenderBody()
    </main>

    <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-7xl px-4 py-4 text-sm text-slate-600">
            eCampus — Plateforme de gestion et de suivi des activités académiques
        </div>
    </footer>

    @* Ouvre et ferme le menu sur petit écran *@
    <script>
        (function () {
            const bouton = document.getElementById('btn-menu');
            const menu = document.getElementById('menu-principal');
            if (!bouton || !menu) return;

            bouton.addEventListener('click', function () {
                const ouvert = bouton.getAttribute('aria-expanded') === 'true';
                bouton.setAttribute('aria-expanded', String(!ouvert));
                menu.classList.toggle('hidden');
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>