@using Microsoft.AspNetCore.Identity
@using eCampus.web.Models.EAcademie
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="flex items-center gap-2">
        <span class="text-sm text-slate-200">@User.Identity?.Name</span>

        @* La déconnexion doit être un POST : un GET pourrait être déclenché par un site tiers *@
        <form asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button type="submit"
                    class="rounded-md bg-slate-700 px-3 py-2 text-sm hover:bg-slate-600 focus:outline-none focus:ring-2 focus:ring-white">
                Se déconnecter
            </button>
        </form>
    </div>
}
else
{
    <div class="flex items-center gap-2">
        <a asp-area="Identity" asp-page="/Account/Login"
           class="rounded-md px-3 py-2 text-sm hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-white">
            Se connecter
        </a>
    </div>
}